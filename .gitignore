# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Allow non-secret environment configuration
!terraform/environments/dev/terraform.tfvars
!terraform/environments/prod/terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment / secrets
.env
.env.*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc